{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf8",
  "width": 480,
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 16,
      "titleFontSize": 16,
      "gridColor": "#e2dfd5"
    },
    "title": {
      "fontSize": 18,
      "anchor": "start",
      "subtitleFontSize": 16,
      "subtitleColor": "#4c5556"
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 16,
      "titleFontSize": 16,
      "labelLimit": 650
    }
  },
  "data": {
    "url": "charts/3-open-preconditions.csv"
  },
  "title": {
    "text": "Different gaps remain",
    "subtitle": "Present resources in open/partial and comparison cases"
  },
  "height": 900,
  "mark": {
    "type": "rect",
    "stroke": "#fffdf8",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "heading",
      "type": "ordinal",
      "sort": [
        "Parallel/key",
        "Documented",
        "Proposed",
        "Comparator",
        "Script type",
        "Names"
      ],
      "axis": {
        "title": null,
        "labelAngle": -35,
        "labelFontSize": 16
      }
    },
    "y": {
      "field": "case",
      "type": "ordinal",
      "sort": null,
      "axis": {
        "title": null,
        "labelLimit": 220
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": [
          "yes",
          "partial",
          "no",
          "uncertain"
        ],
        "range": [
          "#23656c",
          "#c79b36",
          "#e3dfd4",
          "#859398"
        ]
      },
      "title": "Evidence code"
    },
    "tooltip": [
      {
        "field": "case"
      },
      {
        "field": "condition"
      },
      {
        "field": "state"
      },
      {
        "field": "source_ids"
      }
    ],
    "opacity": {
      "condition": {
        "param": "state_pick",
        "value": 1
      },
      "value": 0.2
    }
  },
  "params": [
    {
      "name": "state_pick",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ]
      },
      "bind": "legend"
    }
  ]
}
