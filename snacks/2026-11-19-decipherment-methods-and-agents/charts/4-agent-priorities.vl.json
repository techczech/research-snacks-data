{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf8",
  "width": "container",
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#e2dfd5"
    },
    "title": {
      "fontSize": 18,
      "anchor": "start",
      "subtitleFontSize": 12,
      "subtitleColor": "#4c5556"
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 12
    }
  },
  "data": {
    "url": "charts/4-agent-priorities.csv"
  },
  "title": {
    "text": "Agent priorities: rank within each task group",
    "subtitle": "Ordinal judgement /18; groups have different tasks. Equal totals are tied; Vinča is unranked."
  },
  "height": 730,
  "mark": {
    "type": "bar",
    "height": 17
  },
  "encoding": {
    "x": {
      "field": "total",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          18
        ]
      },
      "axis": {
        "title": "Six criteria, each scored 0–3",
        "tickMinStep": 1
      }
    },
    "y": {
      "field": "case",
      "type": "nominal",
      "sort": [
        "Proto-Elamite",
        "Khitan small script",
        "Linear A",
        "Proto-Sinaitic gaps",
        "Ancient Zapotec writing",
        "Khitan large script",
        "Indus signs",
        "Isthmian / Epi-Olmec",
        "Linear Elamite",
        "Rongorongo",
        "Voynich manuscript",
        "Byblos pseudo-hieroglyphic / syllabary",
        "Eteocypriot",
        "Cretan hieroglyphs",
        "Cypro-Minoan",
        "Singapore Stone",
        "Olmec / Cascajal block",
        "Phaistos disc",
        "Oracle bone Chinese: remaining character gaps",
        "Jurchen",
        "Etruscan language",
        "Iberian language",
        "Meroitic language",
        "Vinča symbols"
      ],
      "axis": {
        "title": null,
        "labelLimit": 235
      }
    },
    "color": {
      "field": "cohort",
      "type": "nominal",
      "scale": {
        "domain": [
          "Undeciphered / partly mapped",
          "Readable, remaining gaps",
          "Excluded non-writing comparator"
        ],
        "range": [
          "#23656c",
          "#a47724",
          "#859398"
        ]
      },
      "title": "Task group"
    },
    "tooltip": [
      {
        "field": "case"
      },
      {
        "field": "cohort"
      },
      {
        "field": "rank"
      },
      {
        "field": "total",
        "type": "quantitative"
      },
      {
        "field": "language_double_rank"
      },
      {
        "field": "status"
      },
      {
        "field": "agent_loop"
      }
    ],
    "opacity": {
      "condition": {
        "param": "state_pick",
        "value": 1
      },
      "value": 0.2
    }
  },
  "params": [
    {
      "name": "state_pick",
      "select": {
        "type": "point",
        "fields": [
          "cohort"
        ]
      },
      "bind": "legend"
    }
  ]
}
