{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf8",
  "width": 480,
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 16,
      "titleFontSize": 16,
      "gridColor": "#e2dfd5"
    },
    "title": {
      "fontSize": 18,
      "anchor": "start",
      "subtitleFontSize": 16,
      "subtitleColor": "#4c5556"
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 16,
      "titleFontSize": 16,
      "labelLimit": 650
    }
  },
  "data": {
    "url": "charts/4-agent-priorities.csv"
  },
  "title": {
    "text": "Different tasks need different checks",
    "subtitle": "Unordered within each group; no estimate of decipherment prospects"
  },
  "height": 1000,
  "mark": {
    "type": "point",
    "filled": true,
    "size": 130
  },
  "encoding": {
    "x": {
      "field": "task_group",
      "type": "nominal",
      "sort": [
        "Structure without language",
        "Partly read, with a language to test against",
        "Audit of a published proposal",
        "Script readable, language not understood",
        "Language known, individual signs unread",
        "Limited by evidence"
      ],
      "axis": null
    },
    "y": {
      "field": "case",
      "type": "nominal",
      "sort": [
        "Indus signs",
        "Khipu (comparison)",
        "Linear A",
        "Proto-Elamite",
        "Issyk-Kushan",
        "Khitan large script",
        "Khitan small script",
        "Isthmian / Epi-Olmec",
        "Linear Elamite",
        "Eteocypriot",
        "Etruscan language",
        "Iberian language",
        "Meroitic language",
        "Jurchen",
        "Maya hieroglyphs (residual signs)",
        "Oracle bone Chinese: remaining character gaps",
        "Tangut (residual signs)",
        "Ancient Zapotec writing",
        "Byblos pseudo-hieroglyphic / syllabary",
        "Cretan hieroglyphs",
        "Cypro-Minoan",
        "Olmec / Cascajal block",
        "Phaistos disc",
        "Proto-Sinaitic gaps",
        "Rongorongo",
        "Singapore Stone",
        "Voynich manuscript"
      ],
      "axis": {
        "title": null,
        "labelLimit": 250
      }
    },
    "color": {
      "field": "task_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Structure without language",
          "Partly read, with a language to test against",
          "Audit of a published proposal",
          "Script readable, language not understood",
          "Language known, individual signs unread",
          "Limited by evidence"
        ],
        "range": [
          "#23656c",
          "#b47a1c",
          "#3b78a0",
          "#738c36",
          "#a34c32",
          "#68777b"
        ]
      },
      "title": "Kind of task",
      "legend": {
        "columns": 1,
        "labelLimit": 650
      }
    },
    "tooltip": [
      {
        "field": "case"
      },
      {
        "field": "task_group"
      },
      {
        "field": "checkable_result"
      },
      {
        "field": "obstacle"
      }
    ],
    "opacity": {
      "condition": {
        "param": "state_pick",
        "value": 1
      },
      "value": 0.2
    }
  },
  "params": [
    {
      "name": "state_pick",
      "select": {
        "type": "point",
        "fields": [
          "task_group"
        ]
      },
      "bind": "legend"
    }
  ]
}
