{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf8",
  "width": 480,
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 16,
      "titleFontSize": 16,
      "gridColor": "#e2dfd5"
    },
    "title": {
      "fontSize": 18,
      "anchor": "start",
      "subtitleFontSize": 16,
      "subtitleColor": "#4c5556"
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 16,
      "titleFontSize": 16,
      "labelLimit": 650
    }
  },
  "data": {
    "url": "charts/2-shared-preconditions.csv"
  },
  "title": {
    "text": "What the decipherers had to work with",
    "subtitle": "Provisional coding by one compiler; selected dependent stages"
  },
  "height": 340,
  "mark": {
    "type": "bar",
    "height": 26
  },
  "encoding": {
    "x": {
      "field": "count",
      "type": "quantitative",
      "stack": "zero",
      "axis": {
        "title": "Cases",
        "tickMinStep": 1
      }
    },
    "y": {
      "field": "condition",
      "type": "nominal",
      "sort": null,
      "axis": {
        "title": null,
        "labelLimit": 260
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": [
          "yes",
          "partial",
          "no",
          "uncertain"
        ],
        "range": [
          "#23656c",
          "#c79b36",
          "#e3dfd4",
          "#859398"
        ]
      },
      "title": "Evidence code"
    },
    "order": {
      "field": "state",
      "sort": "ascending"
    },
    "tooltip": [
      {
        "field": "condition"
      },
      {
        "field": "state"
      },
      {
        "field": "count",
        "type": "quantitative"
      },
      {
        "field": "denominator",
        "type": "quantitative"
      }
    ],
    "opacity": {
      "condition": {
        "param": "state_pick",
        "value": 1
      },
      "value": 0.2
    }
  },
  "params": [
    {
      "name": "state_pick",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ]
      },
      "bind": "legend"
    }
  ]
}
